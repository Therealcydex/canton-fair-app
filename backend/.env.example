PORT=3000
# Production behind nginx (deploy/README.md): listen on the server itself only, trust nginx.
# HOST=127.0.0.1
# TRUST_PROXY=1
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sourcing_db
JWT_SECRET=<long random string>
JWT_EXPIRES_IN=12h

# Used once by `npm run db:setup` to create the super-admin user
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<choose a password>
